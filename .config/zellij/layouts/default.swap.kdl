swap_tiled_layout name="tiled" {
    tab max_panes=6 {
        pane split_direction="vertical" {
            pane
            pane split_direction="horizontal" { children; }
        }
    }
}

swap_tiled_layout name="stacked" {
    tab min_panes=6 {
        pane split_direction="vertical" {
            pane
            pane stacked=true { children; }
        }
    }
}

swap_floating_layout name="default" {
    floating_panes exact_panes=1 {
        pane { x "51%"; y "1"; width "51%"; height "98%"; }
    }
    floating_panes exact_panes=2 {
        pane { x "51%"; y "1"; width "51%"; height "49%"; }
        pane { x "51%"; y "50%"; width "51%"; height "51%"; }
    }
    floating_panes exact_panes=3 {
        pane { x "51%"; y "1"; width "51%"; height "33%"; }
        pane { x "51%"; y "34%"; width "51%"; height "33%"; }
        pane { x "51%"; y "67%"; width "51%"; height "35%"; }
    }
}
